# Application
NODE_ENV=development
PORT=3000

# Database
DATABASE_URL="file:./prisma/dev.db"

# JWT
JWT_SECRET=conectovolt-jwt-secret-change-in-production
JWT_REFRESH_SECRET=conectovolt-refresh-secret-change-in-production
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# OCPP WebSocket
OCPP_PORT=3001

# Mercado Pago
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=
