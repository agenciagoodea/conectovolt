# Application
NODE_ENV=development
PORT=3000
HOST=127.0.0.1
DB_PROVIDER=mysql

# Database
DATABASE_URL="mysql://conectovolt:conectovolt@127.0.0.1:3306/conectovolt"

# JWT
JWT_SECRET=conectovolt-jwt-secret-change-in-production
JWT_REFRESH_SECRET=conectovolt-refresh-secret-change-in-production
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# OCPP WebSocket
OCPP_PORT=3001
OCPP_HOST=0.0.0.0
OCPP_SHARED_TOKEN=change-this-device-token

# Mercado Pago
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=

# Password reset email
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
FRONTEND_URL=http://localhost:3000
